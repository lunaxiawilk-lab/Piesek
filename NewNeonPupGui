    nameLabel.Size = UDim2.new(1, -58, 1, 0)
    nameLabel.Text = name
    nameLabel.TextColor3 = COLORS.Text
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = button

    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = COLORS.Panel2
    end)

    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = COLORS.Panel
    end)

    button.Activated:Connect(function()
        playEmote(name)
    end)

    emoteButtons[name] = button
end

--============================================================
-- SEARCH FILTER
--============================================================

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local query = string.lower(searchBox.Text)

    for _, data in ipairs(emoteData) do
        local name = data[1]
        local button = emoteButtons[name]

        if button then
            if query == ""
                or string.find(string.lower(name), query, 1, true) then

                button.Visible = true
            else
                button.Visible = false
            end
        end
    end
end)

--============================================================
-- BUTTON EVENTS
--============================================================

enableButton.Activated:Connect(function()
    if enabled then
        statusInfo.Text = "Already enabled"
        return
    end

    enableSystem()
end)

disableButton.Activated:Connect(function()
    disableSystem()
end)

emotesButton.Activated:Connect(function()
    emoteWindow.Visible = not emoteWindow.Visible
end)

emoteClose.Activated:Connect(function()
    emoteWindow.Visible = false
end)

local minimized = false
local normalSize = main.Size

minimizeButton.Activated:Connect(function()
    minimized = not minimized

    if minimized then
        main.Size = UDim2.fromOffset(360, 75)

        for _, child in ipairs(main:GetChildren()) do
            if child ~= header
                and child ~= mainStroke
                and child ~= mainCorner
                and child ~= gradient then

                if child:IsA("GuiObject") then
                    child.Visible = false
                end
            end
        end

        header.Visible = true
    else
        main.Size = normalSize

        for _, child in ipairs(main:GetChildren()) do
            if child:IsA("GuiObject") then
                child.Visible = true
            end
        end
    end
end)

destroyButton.Activated:Connect(function()
    destroyed = true

    disableSystem()

    disconnectAll()

    if screenGui then
        screenGui:Destroy()
    end
end)

closeButton.Activated:Connect(function()
    if emoteWindow.Visible then
        emoteWindow.Visible = false
    else
        main.Visible = false
    end
end)

--============================================================
-- DRAG
--============================================================

makeDraggable(main, header)
makeDraggable(emoteWindow, emoteHeader)

--============================================================
-- CHARACTER RESPAWN
--============================================================

table.insert(
    connections,
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)

        if destroyed then
            return
        end

        loadCharacter(char)

        if enabled then
            task.wait(0.3)
            enableSystem()
        end
    end)
)

--============================================================
-- INITIAL CHARACTER
--============================================================

if player.Character then
    task.spawn(function()
        loadCharacter(player.Character)
    end)
else
    local char = player.CharacterAdded:Wait()
    loadCharacter(char)
end

--============================================================
-- FINAL
--============================================================

statusInfo.Text = "Ready • Press Enable"

print("🐾 Puppy Boy GUI v2 loaded successfully!")
