--============================================================
-- CHARACTER
--============================================================

local function loadCharacter(char)
    if destroyed then
        return
    end

    disconnectList(movementConnections)
    idleToken += 1
    manualEmotePlaying = false

    destroyAllTracks()

    character = char
    humanoid = char:WaitForChild("Humanoid", 10)

    if not humanoid then
        statusInfo.Text = "Humanoid not found"
        return
    end

    animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    runTrack = createAnimation(
        customRunId,
        Enum.AnimationPriority.Movement,
        true
    )

    walkTrack = createAnimation(
        customWalkId,
        Enum.AnimationPriority.Movement,
        true
    )

    idleTrack1 = createAnimation(
        customIdle1Id,
        Enum.AnimationPriority.Idle,
        true
    )

    idleTrack2 = createAnimation(
        customIdle2Id,
        Enum.AnimationPriority.Idle,
        true
    )

    for _, data in ipairs(emoteData) do
        local name = data[1]
        local id = data[3]

        local track = createAnimation(
            id,
            Enum.AnimationPriority.Action4,
            false
        )

        if track then
            emoteTracks[name] = track
        end
    end

    statusInfo.Text = "Character loaded • Ready"

    if enabled then
        task.defer(function()
            if not destroyed then
                enabled = false
                local wasOpen = true
                if wasOpen then
                    -- rebind movement connections
                    enabled = true

                    disconnectList(movementConnections)

                    table.insert(
                        movementConnections,
                        humanoid.Running:Connect(function(speed)
                            if not enabled or manualEmotePlaying then
                                return
                            end

                            if speed <= 0.1 then
                                idleToken += 1
                                safeStop(runTrack)
                                safeStop(walkTrack)

                                if idleTrack1 and not idleTrack1.IsPlaying then
                                    idleTrack1:Play(0.25)
                                end
                                return
                            end

                            idleToken += 1
                            safeStop(idleTrack1)
                            safeStop(idleTrack2)

                            if speed >= 12 then
                                safeStop(walkTrack)

                                if runTrack and not runTrack.IsPlaying then
                                    runTrack:Play(0.2)
                                end
                            else
                                safeStop(runTrack)

                                if walkTrack and not walkTrack.IsPlaying then
                                    walkTrack:Play(0.2)
                                end
                            end
                        end)
                    )
                end
            end
        end)
    end
end

--============================================================
-- IDLE
--============================================================

local function startIdle()
    if not enabled or manualEmotePlaying or not humanoid then
        return
    end

    idleToken += 1
    local token = idleToken

    safeStop(runTrack)
    safeStop(walkTrack)

    if idleTrack1 and not idleTrack1.IsPlaying then
        idleTrack1.Looped = true
        idleTrack1:Play(0.25)
    end

    task.spawn(function()
        task.wait(7)

        if destroyed or token ~= idleToken or not enabled or manualEmotePlaying then
            return
        end

        safeStop(idleTrack1, 0.35)

        if idleTrack2 then
            idleTrack2.Looped = true
            idleTrack2:Play(0.35)
        end

        task.wait(7)

        if destroyed or token ~= idleToken or not enabled or manualEmotePlaying then
            return
        end

        startIdle()
    end)
end

--============================================================
-- MOVEMENT
--============================================================

local function updateMovement(speed)
    if not enabled or manualEmotePlaying or not humanoid then
        return
    end

    local state = humanoid:GetState()

    if state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.Dead then

        idleToken += 1
        safeStop(walkTrack)
        safeStop(runTrack)
        safeStop(idleTrack1)
        safeStop(idleTrack2)
        return
    end

    if speed <= 0.1 then
        startIdle()
        return
    end

    idleToken += 1
    safeStop(idleTrack1)
    safeStop(idleTrack2)

    if speed >= 12 then
        safeStop(walkTrack)

        if runTrack and not runTrack.IsPlaying then
            runTrack.Looped = true
            runTrack:Play(0.2)
        end

        if runTrack then
            runTrack:AdjustSpeed(math.clamp(speed / 16, 0.7, 1.6))
        end
    else
        safeStop(runTrack)

        if walkTrack and not walkTrack.IsPlaying then
            walkTrack.Looped = true
            walkTrack:Play(0.2)
        end

        if walkTrack then
            walkTrack:AdjustSpeed(math.clamp(speed / 8, 0.7, 1.5))
        end
    end
end

--============================================================
-- ENABLE / DISABLE
--============================================================

local function bindMovement()
    disconnectList(movementConnections)

    if not humanoid then
        return
    end

    table.insert(
        movementConnections,
        humanoid.Running:Connect(updateMovement)
    )

    table.insert(
        movementConnections,
        humanoid.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Jumping
                or newState == Enum.HumanoidStateType.Freefall then

                idleToken += 1
                safeStop(walkTrack)
                safeStop(runTrack)
                safeStop(idleTrack1)
                safeStop(idleTrack2)
            end
        end)
    )
end

local function enableSystem()
    if destroyed then
        return
    end

    if not humanoid then
        statusInfo.Text = "Character not ready"
        return
    end

    if enabled then
        statusInfo.Text = "Already enabled"
        return
    end

    enabled = true
    manualEmotePlaying = false

    statusDot.Text = "🟢"
    statusLabel.Text = "Online"
    statusLabel.TextColor3 = COLORS.Green
    statusInfo.Text = "Animation system enabled"

    bindMovement()
    startIdle()
end

local function disableSystem()
    enabled = false
    manualEmotePlaying = false
    idleToken += 1

    disconnectList(movementConnections)
    stopAllTracks()

    statusDot.Text = "🔴"
    statusLabel.Text = "Offline"
    statusLabel.TextColor3 = COLORS.Red
    statusInfo.Text = "Animation system disabled"
end

--============================================================
-- EMOTES
--============================================================

local function playEmote(name)
    if not enabled then
        statusInfo.Text = "Enable the system first"
        return
    end

    local track = emoteTracks[name]

    if not track then
        statusInfo.Text = "Animation unavailable: " .. name
        return
    end

    manualEmotePlaying = true
    idleToken += 1

    safeStop(walkTrack)
    safeStop(runTrack)
    safeStop(idleTrack1)
    safeStop(idleTrack2)

    for _, otherTrack in pairs(emoteTracks) do
        if otherTrack ~= track then
            safeStop(otherTrack)
        end
    end

    track.Looped = false

    local success = pcall(function()
        track:Play(0.2)
    end)

    if not success then
        manualEmotePlaying = false
        statusInfo.Text = "Could not play: " .. name
        return
    end

    statusInfo.Text = "Playing: " .. name

    task.spawn(function()
        local started = os.clock()

        while track.IsPlaying and os.clock() - started < 30 do
            task.wait(0.1)
        end

        if manualEmotePlaying then
            manualEmotePlaying = false

            if enabled then
                statusInfo.Text = "Animation system enabled"
                startIdle()
            end
        end
    end)
end

