--============================================================
-- DRAG FUNCTION
--============================================================

local function makeDraggable(frame, handle)

    handle = handle or frame

    local dragging = false
    local dragStart = nil
    local startPosition = nil
    local dragInput = nil

    local function update(input)

        if not dragging then
            return
        end

        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,

            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end

    local beganConnection = handle.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = frame.Position

            if input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end
    end)

    local changedConnection = handle.InputChanged:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            dragInput = input
        end
    end)

    local globalChangedConnection =
        UserInputService.InputChanged:Connect(function(input)

            if dragging and input == dragInput then
                update(input)
            end
        end)

    local endedConnection =
        UserInputService.InputEnded:Connect(function(input)

            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then

                dragging = false
                dragInput = nil
            end
        end)

    table.insert(connections, beganConnection)
    table.insert(connections, changedConnection)
    table.insert(connections, globalChangedConnection)
    table.insert(connections, endedConnection)
end

