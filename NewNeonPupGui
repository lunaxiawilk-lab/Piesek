--============================================================
-- DRAG SYSTEM
--============================================================

local function makeDraggable(frame, handle)
    handle = handle or frame

    local dragging = false
    local dragStart
    local startPosition

    local began = handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
        end
    end)

    local changed = handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local moveConnection

            moveConnection = input.Changed:Connect(function()
                if not dragging then
                    if moveConnection then
                        moveConnection:Disconnect()
                    end
                    return
                end

                local delta = input.Position - dragStart

                frame.Position = UDim2.new(
                    startPosition.X.Scale,
                    startPosition.X.Offset + delta.X,
                    startPosition.Y.Scale,
                    startPosition.Y.Offset + delta.Y
                )
            end)

            table.insert(connections, moveConnection)
        end
    end)

    local ended = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
        end
    end)

    table.insert(connections, began)
    table.insert(connections, changed)
    table.insert(connections, ended)
end

