--============================================================
-- HELPERS
--============================================================

local function animationId(id)
    id = tostring(id)

    if id:find("rbxassetid://", 1, true) then
        return id
    end

    return "rbxassetid://" .. id
end

local function stopTrack(track, fade)
    if track then
        pcall(function()
            track:Stop(fade or 0.15)
        end)
    end
end

local function destroyTrack(track)
    if track then
        pcall(function()
            track:Stop(0)
            track:Destroy()
        end)
    end
end

local function stopAllTracks()
    stopTrack(runTrack)
    stopTrack(walkTrack)
    stopTrack(idleTrack1)
    stopTrack(idleTrack2)

    for _, track in pairs(emoteTracks) do
        stopTrack(track)
    end
end

local function disconnectAll()
    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(connections)
end

local function createAnimation(id, priority, looped)
    if not animator then
        return nil
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = animationId(id)

    local success, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    animation:Destroy()

    if not success or not track then
        return nil
    end

    track.Priority = priority
    track.Looped = looped

    return track
end

