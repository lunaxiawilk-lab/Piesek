--============================================================
-- HELPERS
--============================================================

local function animationId(id)
    id = tostring(id)

    if string.find(id, "rbxassetid://", 1, true) then
        return id
    end

    return "rbxassetid://" .. id
end

local function safeStop(track, fade)
    if track then
        pcall(function()
            track:Stop(fade or 0.15)
        end)
    end
end

local function safeDestroy(track)
    if track then
        pcall(function()
            track:Stop(0)
            track:Destroy()
        end)
    end
end

local function disconnectList(list)
    for _, connection in ipairs(list) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(list)
end

local function stopAllTracks()
    safeStop(runTrack)
    safeStop(walkTrack)
    safeStop(idleTrack1)
    safeStop(idleTrack2)

    for _, track in pairs(emoteTracks) do
        safeStop(track)
    end
end

local function destroyAllTracks()
    safeDestroy(runTrack)
    safeDestroy(walkTrack)
    safeDestroy(idleTrack1)
    safeDestroy(idleTrack2)

    runTrack = nil
    walkTrack = nil
    idleTrack1 = nil
    idleTrack2 = nil

    for name, track in pairs(emoteTracks) do
        safeDestroy(track)
        emoteTracks[name] = nil
    end
end

local function createAnimation(id, priority, looped)
    if not animator then
        return nil
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = animationId(id)

    local success, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    animation:Destroy()

    if not success or not track then
        return nil
    end

    track.Priority = priority
    track.Looped = looped

    return track
end

