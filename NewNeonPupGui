            stroke,
            TweenInfo.new(0.12),
            {
                Transparency = 0.8
            }
        ):Play()
    end)

    button.MouseButton1Click:Connect(function()

        local character = player.Character

        if not character or not isCustomAnimActive then
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")

        if not humanoid then
            return
        end

        local state = humanoid:GetState()

        if humanoid.MoveDirection.Magnitude >= 0.1 then
            return
        end

        if isSpecialMovementState(state) then
            return
        end

        local track = loadedManualEmotes[data.Name]

        if not track then
            return
        end

        stopAllManualTracks()

        isManualEmotePlaying = true

        playTrack(track, 0.25)

        local connection

        connection = track.Stopped:Connect(function()

            isManualEmotePlaying = false

            if connection then
                connection:Disconnect()
            end

            if humanoid
                and humanoid.Parent
                and humanoid.MoveDirection.Magnitude < 0.1
            then
                task.wait(0.1)

                if isCustomAnimActive then
                    startIdleSequence()
                end
            end
        end)
    end)
end

