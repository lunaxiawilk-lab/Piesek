local function disableSystem()
    enabled = false
    manualEmotePlaying = false

    idleToken += 1

    stopAllTracks()

    statusDot.Text = "🔴"
    statusLabel.Text = "Offline"
    statusLabel.TextColor3 = COLORS.Red
    statusInfo.Text = "Animation system disabled"

    disconnectAll()

    -- Character loading connection will be restored below.
    if character and humanoid then
        -- nothing
    end
end

--============================================================
-- EMOTE PLAY
--============================================================

local function playEmote(name)
    if not enabled then
        statusInfo.Text = "Enable animation system first"
        return
    end

    local track = emoteTracks[name]

    if not track then
        statusInfo.Text = "Animation unavailable: " .. name
        return
    end

    manualEmotePlaying = true
    idleToken += 1

    stopTrack(walkTrack)
    stopTrack(runTrack)
    stopTrack(idleTrack1)
    stopTrack(idleTrack2)

    for _, otherTrack in pairs(emoteTracks) do
        if otherTrack ~= track then
            stopTrack(otherTrack)
        end
    end

    track.Looped = false

    pcall(function()
        track:Play(0.2)
    end)

    statusInfo.Text = "Playing: " .. name

    task.spawn(function()
        local start = os.clock()

        while track.IsPlaying and os.clock() - start < 30 do
            task.wait(0.1)
        end

        if manualEmotePlaying then
            manualEmotePlaying = false

            if enabled then
                statusInfo.Text = "Animation system enabled"
                startIdle()
            end
        end
    end)
end

